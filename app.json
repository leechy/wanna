{
  "expo": {
    "name": "Wanna²",
    "slug": "wanna-wanna",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wanna",
    "githubUrl": "https://github.com/leechy/wanna",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "primaryColor": "#3a1fc1",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wanna-wanna.app",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "icon": {
        "light": "./assets/ios-icon.png",
        "dark": "./assets/ios-icon-dark.png",
        "tinted": "./assets/ios-icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:app.wanna-wanna.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/android-icon-mono.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.wannawanna.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.wanna-wanna.com",
              "pathPrefix": "/shared"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/android-icon.png",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/android-icon-dark.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GreatVibes-Regular.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep public class com.horcrux.svg.** {*;}"
          }
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#3a1fc1",
                "dark": "#ffd700"
              },
              "textColor": {
                "light": "#3a1fc1",
                "dark": "#ffd700"
              },
              "colorControlActivated": {
                "light": "#3a1fc1",
                "dark": "#ffd700"
              }
            }
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-notifications.png",
          "color": "#3a1fc1"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1555217c-4179-4b6b-8705-2b9b92556351"
      }
    }
  }
}
